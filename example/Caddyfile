# Sample Caddyfile for caddy-plausible-analytics
#
# Serve /srv with server-side Plausible Analytics tracking.
#
# To use with your own domain, replace domain_to_track.example with your domain, e.g.:
#   example.com { ... }

# Global options block must come first
{
    # Register plausible before file_server so it runs first
    order plausible before file_server

    # Admin API — bind to localhost only; remove this block to use the default
    admin localhost:2019
}

:80 {
    root * /srv

    # Track server-side pageviews via Plausible Analytics.
    # base_url is optional and defaults to https://plausible.io
    plausible {
        domain_name domain_to_track.example
        base_url https://plausible.io
    }

    # Serve static files
    file_server

    # Optional: structured access logging
    log {
        output stdout
        format console
    }
}
